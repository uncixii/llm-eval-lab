{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string"
    },
    "overall_pass": {
      "type": "boolean"
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "category": {
            "enum": [
              "outcome",
              "process",
              "quality",
              "efficiency",
              "risk",
              "diagnostic"
            ]
          },
          "score": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "notes": {
            "type": "string"
          },
          "source": {
            "enum": [
              "deterministic",
              "rubric",
              "llm",
              "human"
            ]
          },
          "verdict": {
            "enum": [
              "pass",
              "fail",
              "unknown"
            ]
          },
          "weight": {
            "type": "number",
            "minimum": 0
          },
          "must_pass": {
            "type": "boolean"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "category",
          "verdict",
          "score",
          "notes",
          "source",
          "weight",
          "must_pass",
          "evidence"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "verdict": {
                  "const": "unknown"
                }
              }
            },
            "then": {
              "properties": {
                "score": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "score": {
                  "type": "number"
                }
              }
            }
          }
        ]
      },
      "minItems": 1
    },
    "schema_version": {
      "const": 2
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "case_id",
    "overall_pass",
    "score",
    "checks",
    "schema_version",
    "run_id"
  ],
  "additionalProperties": false
}
