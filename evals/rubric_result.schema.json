{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "case_id": {"type": "string"},
    "overall_pass": {"type": "boolean"},
    "score": {"type": "number", "minimum": 0, "maximum": 100},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "category": {"enum": ["outcome", "process", "quality", "efficiency"]},
          "pass": {"type": "boolean"},
          "score": {"type": "number", "minimum": 0, "maximum": 1},
          "notes": {"type": "string"},
          "source": {"enum": ["deterministic", "rubric", "llm"]}
        },
        "required": ["id", "category", "pass", "score", "notes", "source"],
        "additionalProperties": false
      }
    }
  },
  "required": ["case_id", "overall_pass", "score", "checks"],
  "additionalProperties": false
}
